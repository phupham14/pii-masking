# Sao chép thành app/.env rồi điền. KHÔNG commit .env.
# Sinh key:  python -c "import secrets; print(secrets.token_urlsafe(50))"
#            python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api

# Master key bọc khoá của từng job. MẤT KEY = MẤT mọi file gốc / mapping đã lưu. Giữ ở nơi an toàn (vault).
# Đổi key: PII_MASTER_KEYS=key_mới,key_cũ -> manage.py rewrap_keys -> PII_MASTER_KEYS=key_mới
PII_MASTER_KEY=change-me

# Đăng nhập (JWT). Tạo user: docker compose exec api python manage.py adduser <tên>
JWT_ACCESS_MINUTES=30
JWT_REFRESH_HOURS=12
UPLOAD_RATE=60/hour
LOGIN_RATE=10/minute
CACHE_URL=redis://redis:6379/1

POSTGRES_HOST=postgres
POSTGRES_DB=pii
POSTGRES_USER=pii
POSTGRES_PASSWORD=change-me

CELERY_BROKER_URL=redis://redis:6379/0
WORKER_CONCURRENCY=2
JOB_SOFT_TIME_LIMIT=3600

STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=pii-masking
S3_ACCESS_KEY=pii-app
S3_SECRET_KEY=change-me-min-8-chars

ORIGINAL_TTL_HOURS=24
OUTPUT_TTL_DAYS=30
MAX_UPLOAD_MB=50

# OCR trang scan (LightOnOCR). Để trống OCR_KEY = tắt OCR: trang scan -> needs_review.
# Container phải truy cập được OCR_URL (gateway qua Tailscale: kiểm tra DNS / route từ trong Docker).
OCR_URL=https://asus.tail3f3df.ts.net
OCR_KEY=
